{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anti-ddos.local/schemas/ipreputation.schema.json",
  "title": "ip-reputation",
  "description": "Allowlist + blocklist d'IP/CIDR avec extension dynamique alimentée par les autres mitigations L3/L4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "on_error", "params"],
      "properties": {
        "id": { "type": "string", "enum": ["ip-reputation"] },
        "enabled": { "type": "boolean" },
        "on_error": { "type": "string", "enum": ["allow", "deny"] },
        "params": { "$ref": "#/$defs/params" },
        "notes": { "type": "string", "maxLength": 1024 },
        "reason": { "type": "string", "maxLength": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowlist", "blocklist", "max_dynamic_entries", "default_block_ttl_ms"],
      "properties": {
        "allowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "allowlist_strict": { "type": "boolean" },
        "blocklist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "max_dynamic_entries": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "default_block_ttl_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    }
  }
}
