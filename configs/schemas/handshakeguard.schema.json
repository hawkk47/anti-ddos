{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anti-ddos.local/schemas/handshakeguard.schema.json",
  "title": "handshake-guard",
  "description": "Détecte les connexions TCP half-open applicatives (pas de premier octet utile).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "on_error", "params"],
      "properties": {
        "id": { "type": "string", "enum": ["handshake-guard"] },
        "enabled": { "type": "boolean" },
        "on_error": { "type": "string", "enum": ["allow", "deny"] },
        "params": { "$ref": "#/$defs/params" },
        "notes": { "type": "string", "maxLength": 1024 },
        "reason": { "type": "string", "maxLength": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handshake_window_ms", "abandon_threshold", "observe_window_ms"],
      "properties": {
        "handshake_window_ms": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "abandon_threshold": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "observe_window_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "report_ttl_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    }
  }
}
