{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anti-ddos.local/schemas/geoblock-l4.schema.json",
  "title": "geoblock-l4",
  "description": "Filtre géographique L4 par code pays ISO-3166-1 alpha-2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "on_error", "params"],
      "properties": {
        "id": { "type": "string", "enum": ["geoblock-l4"] },
        "enabled": { "type": "boolean" },
        "on_error": { "type": "string", "enum": ["allow", "deny"] },
        "params": { "$ref": "#/$defs/params" },
        "notes": { "type": "string", "maxLength": 1024 },
        "reason": { "type": "string", "maxLength": 256 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "block"],
      "properties": {
        "allow": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
          "maxItems": 300
        },
        "block": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
          "maxItems": 300
        }
      }
    }
  }
}
