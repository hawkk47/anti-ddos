{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anti-ddos.local/schemas/connections.schema.json",
  "title": "connections",
  "description": "Mitigations applicables au niveau connexion (anti-Slowloris, anti-flood TCP).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version du document. Incrément monotone à chaque révision."
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "on_error", "params"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["slowloris"],
          "description": "Identifiant canonique de la mitigation."
        },
        "enabled": { "type": "boolean" },
        "on_error": {
          "type": "string",
          "enum": ["allow", "deny"],
          "description": "Comportement sur erreur interne (fail-open vs fail-closed)."
        },
        "params": { "$ref": "#/$defs/slowlorisParams" },
        "notes": { "type": "string", "maxLength": 1024 },
        "reason": {
          "type": "string",
          "maxLength": 256,
          "description": "Obligatoire si enabled=false."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "slowlorisParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_conns_per_ip"],
      "properties": {
        "max_conns_per_ip": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Nombre maximum de connexions TCP concurrentes par IP source."
        }
      }
    }
  }
}
