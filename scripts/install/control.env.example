# Environnement du control plane anti-ddos (Node.js).
# Copiez ce fichier en /etc/anti-ddos/control.env et adaptez.
# Les secrets (tokens) doivent être ajoutés sur la machine,
# pas commités. Utilisez `chmod 600 /etc/anti-ddos/control.env`.

ANTIDDOS_CTRL_HOST=127.0.0.1
ANTIDDOS_CTRL_PORT=9099
ANTIDDOS_CTRL_LOG_LEVEL=info
ANTIDDOS_CTRL_STATE_DIR=/var/lib/anti-ddos/state

# URL d'admin du data plane (loopback recommandé).
ANTIDDOS_PROXY_ADMIN_URL=http://127.0.0.1:8081

# Tokens à compléter sur la machine (>= 16 caractères).
# Requis dès que CTRL_HOST n'est pas loopback.
# ANTIDDOS_CTRL_API_TOKEN=
# ANTIDDOS_PROXY_ADMIN_TOKEN=
