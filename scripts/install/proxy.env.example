# Environnement du data plane anti-ddos (Go).
# Copiez ce fichier en /etc/anti-ddos/proxy.env et adaptez.
# AUCUN SECRET N'EST ÉCRIT ICI — utilisez la commande
# `systemd-creds` ou un secret manager pour ANTIDDOS_ADMIN_TOKEN.

ANTIDDOS_LISTEN=0.0.0.0:443
ANTIDDOS_UPSTREAM=http://127.0.0.1:9000
ANTIDDOS_ADMIN_LISTEN=127.0.0.1:8081

# Timeouts (anti slow-loris / slow-post côté serveur).
ANTIDDOS_READ_HEADER_TIMEOUT=5s
ANTIDDOS_READ_TIMEOUT=30s
ANTIDDOS_WRITE_TIMEOUT=30s
ANTIDDOS_IDLE_TIMEOUT=60s

# Toutes les mitigations sont OFF par défaut.
# Les seuils réels sont poussés à chaud par le control plane.
ANTIDDOS_SLOWLORIS_ENABLED=false
ANTIDDOS_HTTPFLOOD_ENABLED=false
ANTIDDOS_LARGEHEADER_ENABLED=false
ANTIDDOS_SLOWPOST_ENABLED=false
