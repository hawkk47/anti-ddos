[Unit]
Description=anti-ddos control plane (admin API + WAF rule store)
Documentation=https://github.com/hawkk47/anti-ddos
After=network-online.target anti-ddos-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=anti-ddos
Group=anti-ddos
WorkingDirectory=/opt/anti-ddos/control
EnvironmentFile=-/etc/anti-ddos/control.env
ExecStart=/usr/bin/node /opt/anti-ddos/control/dist/index.js
Restart=on-failure
RestartSec=2s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/var/log/anti-ddos /var/lib/anti-ddos

[Install]
WantedBy=multi-user.target
