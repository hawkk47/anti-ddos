{
  "name": "@anti-ddos/control",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Control plane API for the anti-ddos reverse proxy.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-configs": "tsx src/scripts/validate-configs.ts"
  },
  "dependencies": {
    "@fastify/static": "8.0.1",
    "@sinclair/typebox": "0.33.17",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fastify": "5.0.0",
    "yaml": "2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "@types/node": "20.16.10",
    "@typescript-eslint/eslint-plugin": "8.8.0",
    "@typescript-eslint/parser": "8.8.0",
    "eslint": "9.11.1",
    "globals": "^17.6.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  }
}
